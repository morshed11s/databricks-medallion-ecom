Date =
VAR MinDate = MIN ( MIN ( gold_daily_sales[order_date] ), MIN ( gold_payment_success[txn_date] ) )
VAR MaxDate = MAX ( MAX ( gold_daily_sales[order_date] ), MAX ( gold_payment_success[txn_date] ) )
RETURN
    ADDCOLUMNS (
        CALENDAR ( MinDate, MaxDate ),
        "Year", YEAR ( [Date] ),
        "Month", FORMAT ( [Date], "yyyy-MM" ),
        "Week Start", [Date] - WEEKDAY ( [Date], 2 ) + 1
    )

Total Revenue (USD) =
    SUM ( gold_revenue_breakdown[revenue_usd] )

Revenue Orders =
    SUM ( gold_revenue_breakdown[revenue_orders] )

Avg Order Value (USD) =
    DIVIDE ( [Total Revenue (USD)], [Revenue Orders] )

Units Sold =
    SUM ( gold_revenue_breakdown[units_sold] )

Cancellation Rate =
    DIVIDE ( SUM ( gold_daily_sales[cancelled_orders] ), SUM ( gold_daily_sales[total_orders] ) )

Payment Success Rate =
    DIVIDE (
        SUM ( gold_payment_success[successful] ),
        SUM ( gold_payment_success[successful] ) + SUM ( gold_payment_success[failed] )
    )

Total Revenue via Daily Sales (USD) =
    SUM ( gold_daily_sales[revenue_usd] )
