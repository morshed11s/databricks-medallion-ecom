{
  "name": "ecom_medallion_bronze_silver_gold",
  "description": "Landing checks -> Bronze -> Silver -> Gold for workspace.ecom_poc. Manual trigger only (no schedule).",
  "max_concurrent_runs": 1,
  "timeout_seconds": 7200,
  "queue": { "enabled": true },
  "performance_target": "STANDARD",
  "parameters": [
    { "name": "catalog", "default": "workspace" }
  ],
  "email_notifications": {
    "on_failure": ["<YOUR_EMAIL>"],
    "no_alert_for_skipped_runs": true
  },
  "tasks": [
    {
      "task_key": "landing_checks",
      "description": "Verify landed CSVs match generator/manifest.json (rows, bytes, sha256)",
      "notebook_task": {
        "notebook_path": "<GIT_FOLDER_PATH>/notebooks/02_landing_checks",
        "source": "WORKSPACE"
      },
      "max_retries": 0,
      "timeout_seconds": 1800
    },
    {
      "task_key": "bronze",
      "description": "Lossless, idempotent STRING load into bronze_orders / bronze_transactions",
      "depends_on": [{ "task_key": "landing_checks" }],
      "notebook_task": {
        "notebook_path": "<GIT_FOLDER_PATH>/notebooks/03_bronze",
        "source": "WORKSPACE"
      },
      "max_retries": 1,
      "min_retry_interval_millis": 120000,
      "retry_on_timeout": false,
      "timeout_seconds": 3600
    },
    {
      "task_key": "silver",
      "description": "Typing, rule validation, quarantine, deterministic dedup, reconciliation",
      "depends_on": [{ "task_key": "bronze" }],
      "notebook_task": {
        "notebook_path": "<GIT_FOLDER_PATH>/notebooks/04_silver",
        "source": "WORKSPACE"
      },
      "max_retries": 1,
      "min_retry_interval_millis": 120000,
      "retry_on_timeout": false,
      "timeout_seconds": 3600
    },
    {
      "task_key": "gold",
      "description": "Gold marts, documentation and grain/revenue assertions",
      "depends_on": [{ "task_key": "silver" }],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "<GIT_FOLDER_PATH>/notebooks/05_gold",
        "source": "WORKSPACE"
      },
      "max_retries": 1,
      "min_retry_interval_millis": 120000,
      "retry_on_timeout": false,
      "timeout_seconds": 1800
    }
  ]
}
